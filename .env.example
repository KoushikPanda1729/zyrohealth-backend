# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fullhealth
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=fullhealth

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=2048

# Agora Video
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# AWS S3
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# App
PORT=3000
NODE_ENV=development
SOCKET_CORS_ORIGIN=http://localhost:3000

# WhatsApp (WHATSAPP_PROVIDER=dev is safe for local dev — logs messages to console, no credentials needed)
WHATSAPP_PROVIDER=dev
TWILIO_WHATSAPP_FROM_NUMBER=+14155238886
TWILIO_WHATSAPP_TEMPLATE_MAP={}
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=your-meta-access-token
META_WHATSAPP_API_VERSION=v21.0
