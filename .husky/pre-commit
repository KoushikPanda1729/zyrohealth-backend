#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "⏳ Running pre-commit checks..."

echo "Step 1/3: Formatting with Prettier..."
npx prettier --write src || exit 1

echo "Step 2/3: Linting with ESLint..."
npx eslint src --ext .ts --fix || exit 1

echo "Step 3/3: Type checking with tsc..."
if ! npx tsc --noEmit; then
  echo ""
  echo "❌ TypeScript typecheck FAILED. Commit blocked."
  echo "   Fix all type errors before committing."
  exit 1
fi

echo "✅ All checks passed. Proceeding with commit."
